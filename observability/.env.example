# Template for observability/.env (gitignored). Prefer generating it:
#   python scripts/observability_init.py
# Used only by compose.observability.yaml and scripts/smoke_observability.py.
# Code Partner never needs these values; it sends traces to the collector.

# Local Langfuse web UI: http://localhost:${LANGFUSE_PORT}
LANGFUSE_PORT=3000
NEXTAUTH_URL=http://localhost:3000

# CHANGEME: long random values (openssl rand -hex 32)
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=

# Headless initialization: created on Langfuse's first start.
LANGFUSE_INIT_ORG_ID=codepartner
LANGFUSE_INIT_ORG_NAME="Code Partner"
LANGFUSE_INIT_PROJECT_ID=codepartner
LANGFUSE_INIT_PROJECT_NAME="Code Partner"
LANGFUSE_INIT_USER_EMAIL=admin@codepartner.local
LANGFUSE_INIT_USER_NAME="Code Partner Admin"
LANGFUSE_INIT_USER_PASSWORD=

# Langfuse project API keys (pk-lf-... / sk-lf-...). Seeded into the project above.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# Collector -> Langfuse OTLP/HTTP (container DNS on the observability network).
LANGFUSE_OTLP_ENDPOINT=http://langfuse-web:3000/api/public/otel/v1/traces
# base64("LANGFUSE_PUBLIC_KEY:LANGFUSE_SECRET_KEY"), e.g.
#   printf '%s' "pk-lf-...:sk-lf-..." | base64 -w0
LANGFUSE_OTLP_AUTH=
