# Native filesystem execution (docs/native-execution.md).
# Chain the per-project bind mounts after the base file (add compose.kb.yaml etc. here too).
# COMPOSE_FILE=compose.yaml:compose.projects.yaml
# Run the container as the host user that owns the mounted projects (`id -u`, `id -g`).
HOST_UID=1000
HOST_GID=1000
# Optional override for every project: native (default), auto (IDE fallback), ide.
# CODEPARTNER_EXECUTION_MODE=
# Providers allowed to execute natively. Codex runs without its own sandbox in the
# container; read docs/native-execution.md ("What is and is not isolated") first.
CODEPARTNER_NATIVE_PROVIDERS=claude,codex

# Application
MCP_TOOL_TIMEOUT=120
CODEPARTNER_ACI_ENABLED=true
# Seconds a flow switch waits for in-flight IDE writes before giving up.
CODEPARTNER_STOP_WAIT_SECONDS=20
MCP_PUBLIC_BASE=http://127.0.0.1:7777
DOCKER_MCP_PUBLIC_BASE=http://127.0.0.1:7777

# Optional coder tool-result compression (docs/context-compression.md). Off by default.
# Backends: sidecar (include compose.compress.yaml), local (npm ci --ignore-scripts in
# infra/compress-bridge), or noop. Modes: conservative | balanced; error output is
# always conservative, and auto/aggressive are rejected.
CODEPARTNER_COMPRESS_ENABLED=false
CODEPARTNER_COMPRESS_BACKEND=sidecar
CODEPARTNER_COMPRESS_SOCKET=/run/compress-bridge/compress.sock
CODEPARTNER_COMPRESS_MODE=conservative
CODEPARTNER_COMPRESS_MIN_BYTES=4096
CODEPARTNER_COMPRESS_MIN_SAVING=0.05
CODEPARTNER_COMPRESS_TIMEOUT_MS=1500
CODEPARTNER_COMPRESS_CATEGORIES=command,listing,other,search
# Keep original text in the routing database for audit (provenance is always kept).
CODEPARTNER_COMPRESS_PERSIST=false
CODEPARTNER_COMPRESS_PERSIST_DAYS=7

# Optional Codebase Memory planning/review bridge. To enable, also include compose.kb.yaml.
KB_ENABLED=false
KB_PROVIDER=codebase-memory
# KB_BINARY_PATH=/absolute/path/to/codebase-memory-mcp
# KB_DATA_PATH=/absolute/path/to/existing/codebase-memory-mcp/storage
# KB_UID=1000
# KB_GID=1000

# Active provider: claude, codex, or ollama
LLM_PROVIDER=claude
CODER_PROVIDER=claude

# OpenSpec is installed in the image at this path.
OPENSPEC_BIN=/opt/node-tools/bin/openspec

# Ollama running on the Docker host
OLLAMA_HOST=http://127.0.0.1:11434
DOCKER_OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Optional optimizer pipeline
OPTIMIZER_ENABLED=false
OPTIMIZER_MODEL=
OPTIMIZER_MODEL_LADDER=
OPTIMIZER_MIN_CONFIDENCE=medium
OPTIMIZER_READ_CONTEXT=true
OPTIMIZER_MAX_CONTEXT_CALLS=3

# Optional Codex model configuration
CODEX_BIN=codex
CODEX_MODEL=
CODEX_MODEL_SIMPLE=
CODEX_MODEL_MEDIUM=
CODEX_MODEL_COMPLEX=
CODEX_ARGS=

# Exploration / Exact Read rules for native planner, coder and reviewer runs: exploration
# goes to a cheap reader subagent (model: subagents.reader_model in model-routing.yaml)
# whose transcript stays out of the parent's context. Off by default for A/B testing.
# See docs/native-execution.md.
CODEPARTNER_READER_SUBAGENT=false
CODEPARTNER_SUBAGENT_MAX_TURNS=20

# Model routing and gateway. Model aliases and tiers live in
# config/model-routing.yaml; override the model IDs available to your account here.
MODEL_ROUTING_CONFIG=/app/config/model-routing.yaml
SEMANTIC_ROUTER_URL=http://semantic-router:18080
AGENTGATEWAY_URL=http://agentgateway:4000
SEMANTIC_ROUTER_IMAGE=ghcr.io/vllm-project/semantic-router/extproc@sha256:5c5de6867bf5529c747ff38f5a2593a26cdc7c99e906d682ffc55fcc2705f62a
AGENTGATEWAY_IMAGE=cr.agentgateway.dev/agentgateway@sha256:bf2f339ef326d32def2aaeb44b1b4549801293c19b89e764a4228667d97d9896
ROUTING_DB_PATH=/home/codepartner/.codepartner/routing.sqlite3
CLAUDE_MODEL_SIMPLE=haiku
CLAUDE_MODEL_MEDIUM=sonnet
CLAUDE_MODEL_COMPLEX=opus

# For unattended deployments, inject credentials at runtime. Do not commit them.
# ANTHROPIC_API_KEY=
# CODEX_ACCESS_TOKEN=

# Optional OpenTelemetry tracing -> OTel Collector -> Langfuse (docs/observability.md).
# Off by default. Code Partner never needs Langfuse keys; only the collector has them.
# When the collector is down, spans are dropped and executions are unaffected.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=code-partner
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Seconds per export request (the Python SDK reads this value in seconds).
OTEL_EXPORTER_OTLP_TIMEOUT=5
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# Bounded in-memory span queue; full queue drops spans instead of blocking.
OTEL_BSP_MAX_QUEUE_SIZE=2048
# Hard wall-clock bound on flush + shutdown at process exit.
OTEL_SHUTDOWN_TIMEOUT_SECONDS=5
CODEPARTNER_READER_SUBAGENT=true
CODEX_MODEL_SIMPLE=gpt-5.6-luna
