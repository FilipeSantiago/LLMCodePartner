# Application
MCP_TOOL_TIMEOUT=120
MCP_PUBLIC_BASE=http://127.0.0.1:7777
DOCKER_MCP_PUBLIC_BASE=http://127.0.0.1:7777

# Active provider: claude, codex, or ollama
LLM_PROVIDER=claude
CODER_PROVIDER=claude

# OpenSpec is installed in the image at this path.
OPENSPEC_BIN=/opt/node-tools/bin/openspec

# Ollama running on the Docker host
OLLAMA_HOST=http://127.0.0.1:11434
DOCKER_OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Optional optimizer pipeline
OPTIMIZER_ENABLED=false
OPTIMIZER_MODEL=
OPTIMIZER_MODEL_LADDER=
OPTIMIZER_MIN_CONFIDENCE=medium
OPTIMIZER_READ_CONTEXT=true
OPTIMIZER_MAX_CONTEXT_CALLS=3

# Optional Codex model configuration
CODEX_BIN=codex
CODEX_MODEL=
CODEX_MODEL_SIMPLE=
CODEX_MODEL_MEDIUM=
CODEX_MODEL_COMPLEX=
CODEX_ARGS=

# Model routing and gateway. Model aliases and tiers live in
# config/model-routing.yaml; override the model IDs available to your account here.
MODEL_ROUTING_CONFIG=/app/config/model-routing.yaml
SEMANTIC_ROUTER_URL=http://semantic-router:18080
AGENTGATEWAY_URL=http://agentgateway:4000
SEMANTIC_ROUTER_IMAGE=ghcr.io/vllm-project/semantic-router/extproc@sha256:5c5de6867bf5529c747ff38f5a2593a26cdc7c99e906d682ffc55fcc2705f62a
AGENTGATEWAY_IMAGE=cr.agentgateway.dev/agentgateway@sha256:bf2f339ef326d32def2aaeb44b1b4549801293c19b89e764a4228667d97d9896
ROUTING_DB_PATH=/home/codepartner/.codepartner/routing.sqlite3
CLAUDE_MODEL_SIMPLE=haiku
CLAUDE_MODEL_MEDIUM=sonnet
CLAUDE_MODEL_COMPLEX=opus

# For unattended deployments, inject credentials at runtime. Do not commit them.
# ANTHROPIC_API_KEY=
# CODEX_ACCESS_TOKEN=
